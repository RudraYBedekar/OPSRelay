# Copy to .env on EC2:  cp deploy/env.production.example .env
# Then edit secrets before running deploy/ec2-setup.sh

NODE_ENV=production
PORT=3001

# ── Auth (SecureData database) ──
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
AUTH_ENABLED=true
CRDB_SECURE_DATABASE=SecureData
PASSWORD_PEPPER=REPLACE_WITH_openssl_rand_hex_32
AUDIT_IP_SALT=REPLACE_WITH_openssl_rand_hex_32
SEED_DEFAULT_PASSWORD=ChangeMeAfterFirstLogin!

# ── CockroachDB Cloud ──
CRDB_DATABASE=Rudra
DATABASE_URL=postgresql://USER:PASSWORD@CLUSTER.cockroachlabs.cloud:26257/Rudra?sslmode=verify-full

# ── Frontend (used at build time) ──
VITE_USE_CRDB=true
VITE_API_URL=/api

# ── Bedrock — use IAM role on EC2; leave keys empty ──
BEDROCK_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_AGENT_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMENSIONS=1024

# Migration-owner credential (DDL only). Required for: npm run db:migrate
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@CLUSTER.cockroachlabs.cloud:26257/Rudra?sslmode=verify-full

# Exact origins in production (comma-separated)
CORS_ORIGIN=http://YOUR_EC2_IP,http://localhost:5173

# ── Investigator / MCP ──
# Modes: disabled | local_sql_demo | managed_mcp
MCP_MODE=managed_mcp
MCP_ENABLED=true
MCP_SERVER_URL=https://cockroachlabs.cloud/mcp
MCP_CLUSTER_ID=
MCP_ACCESS_TOKEN=
MCP_EVIDENCE_DATABASE=opsrelay_evidence
MCP_QUERY_TIMEOUT_MS=10000
MCP_MAX_RESULTS=10
MCP_ALLOW_SQL_BRIDGE=false
