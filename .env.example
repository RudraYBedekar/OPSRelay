# ── Authentication (required when using CockroachDB API) ──
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_ENABLED=true
SEED_DEFAULT_PASSWORD=
CRDB_SECURE_DATABASE=SecureData
PASSWORD_PEPPER=
AUDIT_IP_SALT=
# Exact origins only in production (comma-separated)
CORS_ORIGIN=http://localhost:5173

# ── CockroachDB Cloud (runtime app credential — no DDL) ──
CRDB_DATABASE=Rudra
DATABASE_URL=

# Migration-owner credential (DDL only). Required for: npm run db:migrate
MIGRATION_DATABASE_URL=

# Optional isolated evidence writer (projection worker). Do not fall back to DATABASE_URL in production.
EVIDENCE_DATABASE_URL=
EVIDENCE_DATABASE_NAME=opsrelay_evidence

# ── API server ──
PORT=3001
NODE_ENV=development

# ── Frontend ──
VITE_USE_CRDB=true
VITE_API_URL=/api

# ── AWS Bedrock ──
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_AGENT_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMENSIONS=1024

# ── Investigator / MCP ──
# Modes: disabled | local_sql_demo | managed_mcp
MCP_MODE=disabled
MCP_ENABLED=false
MCP_SERVER_URL=https://cockroachlabs.cloud/mcp
MCP_CLUSTER_ID=
MCP_ACCESS_TOKEN=
MCP_EVIDENCE_DATABASE=opsrelay_evidence
MCP_QUERY_TIMEOUT_MS=10000
MCP_MAX_RESULTS=10
# Never enable against production unless intentionally bridging for a controlled demo
MCP_ALLOW_SQL_BRIDGE=false
