# ── Authentication (required when using CockroachDB API) ──
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
AUTH_ENABLED=true
SEED_DEFAULT_PASSWORD=OpsRelay2026!
# Separate CockroachDB database for credentials (isolated from Rudra app data)
CRDB_SECURE_DATABASE=SecureData
# Server-side pepper appended before bcrypt (never expose to client)
PASSWORD_PEPPER=change-this-pepper-secret-in-production
AUDIT_IP_SALT=change-this-audit-salt-in-production
# CORS_ORIGIN=http://localhost:5173

# ── CockroachDB Cloud ──
CRDB_DATABASE=Rudra
DATABASE_URL=postgresql://USER:PASSWORD@CLUSTER.cockroachlabs.cloud:26257/Rudra?sslmode=verify-full

# ── API server ──
PORT=3001

# ── Frontend ──
VITE_USE_CRDB=true
VITE_API_URL=/api

# ── AWS Bedrock (set BEDROCK_ENABLED=true after completing AWS setup) ──
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Models (enable in Bedrock Console → Model access first)
BEDROCK_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_AGENT_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMENSIONS=1024
